{
  "name": "openweb",
  "version": "1.6.2",
  "private": false,
  "license": "GPL-3.0-or-later",
  "description": "Open-source browser extension + daemon + MCP server for AI agents",
  "type": "module",
  "bin": {
    "openweb": "./cli.js"
  },
  "scripts": {
    "start": "node daemon.js",
    "daemon": "node daemon.js",
    "mcp": "node mcp-server.js",
    "setup-mcp": "node setup-mcp.js",
    "build:chrome": "node build.js chrome",
    "build:firefox": "node build.js firefox",
    "build:edge": "node build.js edge",
    "test": "node --test test/unit/**/*.test.js",
    "test:e2e": "node test/e2e/test-all-tools.js",
    "test:e2e:simple": "node test/e2e/test-e2e.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "form-data": "^4.0.5",
    "node-fetch": "^2.7.0",
    "ws": "^8.18.0"
  }
}
