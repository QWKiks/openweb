# OpenWeb MCP Environment Variables

# WebSocket URL for the daemon (default: ws://127.0.0.1:10086/ws)
OPENWEB_WS_URL=ws://127.0.0.1:10086/ws

# Optional auth token for daemon connections
# OPENWEB_TOKEN=your-secret-token

# OpenAI API Key — required for speech_to_text transcription tool
OPENAI_API_KEY=sk-...

# Enable verbose debug logging (set to "1" or "true" to enable)
OPENWEB_DEBUG=1
